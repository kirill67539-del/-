 <Window x:Class="DrawingApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Графический редактор"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Margin="5">
            <Button Content="Линия" Width="100" Margin="5"
                    Click="Line_Click"/>
            <Button Content="Круг" Width="100" Margin="5"
                    Click="Circle_Click"/>
            <Button Content="Квадрат" Width="100" Margin="5"
                    Click="Square_Click"/>
            <Button Content="Очистить" Width="100" Margin="5"
                    Click="Clear_Click"/>
        </StackPanel>

        <Border BorderBrush="Gray" BorderThickness="1" Margin="5">
            <Canvas x:Name="DrawingCanvas"
                    Background="White"
                    MouseLeftButtonDown="Canvas_MouseDown"
                    MouseMove="Canvas_MouseMove"
                    MouseLeftButtonUp="Canvas_MouseUp"/>
        </Border>
    </DockPanel>
</Window>