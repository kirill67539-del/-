<Window x:Class="EmployeesApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учет сотрудников" Height="550" Width="650">

    <StackPanel Margin="15">

        <TextBlock Text="Учет сотрудников"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="3,3,3,10"/>

        <TextBlock Text="ФИО сотрудника:"/>
        <TextBox x:Name="NameBox"
                 Width="600" Height="20"
                 HorizontalAlignment="Left" Margin="3"/>

        <TextBlock Text="Должность:"/>
        <TextBox x:Name="PositionBox"
                 Width="600" Height="20"
                 HorizontalAlignment="Left" Margin="3"/>

        <TextBlock Text="Номер телефона:"/>
        <TextBox x:Name="PhoneBox"
                 Width="600" Height="20"
                 HorizontalAlignment="Left" Margin="3"/>

        <TextBlock Text="Зарплата:"/>
        <TextBox x:Name="SalaryBox"
                 Width="600" Height="20"
                 HorizontalAlignment="Left" Margin="3"/>

        <WrapPanel Margin="0,5">
            <Button Content="Добавить"
                    Click="Add_Click"
                    Width="95" Margin="3" Padding="4"/>

            <Button Content="Изменить"
                    Click="Edit_Click"
                    Width="95" Margin="3" Padding="4"/>

            <Button Content="Удалить"
                    Click="Delete_Click"
                    Width="95" Margin="3" Padding="4"/>
        </WrapPanel>

        <TextBlock Text="Список сотрудников:"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="3,8"/>

        <DataGrid x:Name="Grid"
                  Height="200"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  SelectionChanged="Grid_SelectionChanged"/>

    </StackPanel>
</Window>
