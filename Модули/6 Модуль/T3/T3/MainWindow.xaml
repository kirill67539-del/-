<Window x:Class="LibraryApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Библиотека" Height="520" Width="700">

    <StackPanel Margin="15">
        <TextBlock Text="Учет библиотечных книг"
                   FontSize="22" FontWeight="Bold" Margin="3,3,3,12"/>

        <TextBlock Text="Название книги:"/>
        <TextBox x:Name="TitleBox" Height="28" Margin="3"/>

        <TextBlock Text="Автор книги:"/>
        <TextBox x:Name="AuthorBox" Height="28" Margin="3"/>

        <TextBlock Text="Поиск по названию или автору:"/>
        <TextBox x:Name="SearchBox" Height="28" Margin="3"/>

        <WrapPanel Margin="0,5">
            <Button Content="Добавить книгу" Click="Add_Click"
                    Margin="3" Padding="6"/>
            <Button Content="Найти" Click="Search_Click"
                    Width="90" Margin="3" Padding="6"/>
            <Button Content="Арендовать" Click="Rent_Click"
                    Width="110" Margin="3" Padding="6"/>
        </WrapPanel>

        <TextBlock Text="Список книг:" FontSize="16"
                   FontWeight="Bold" Margin="3,8"/>

        <DataGrid x:Name="Grid" Height="230"
                  AutoGenerateColumns="True" IsReadOnly="True"
                  SelectionChanged="Grid_SelectionChanged"/>
    </StackPanel>
</Window>
