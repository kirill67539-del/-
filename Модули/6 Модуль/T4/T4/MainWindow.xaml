<Window x:Class="FinanceApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учет финансов" Height="520" Width="700">

    <StackPanel Margin="15">
        <TextBlock Text="Учет доходов и расходов"
                   FontSize="22" FontWeight="Bold" Margin="3,3,3,12"/>

        <TextBlock Text="Тип операции:"/>
        <ComboBox x:Name="TypeBox" SelectedIndex="0"
                  Height="26" Margin="3">
            <ComboBoxItem Content="Доход"/>
            <ComboBoxItem Content="Расход"/>
        </ComboBox>

        <TextBlock Text="Описание операции:"/>
        <TextBox x:Name="DescriptionBox" Height="20" Margin="3"/>

        <TextBlock Text="Сумма:"/>
        <TextBox x:Name="AmountBox" Height="20" Margin="3"/>

        <WrapPanel Margin="0,5">
            <Button Content="Добавить" Click="Add_Click"
                    Width="100" Margin="3" Padding="6"/>
            <Button Content="Редактировать" Click="Edit_Click"
                    Width="130" Margin="3" Padding="6"/>
        </WrapPanel>

        <TextBlock Text="Список финансовых операций:"
                   FontSize="16" FontWeight="Bold" Margin="3,8"/>

        <DataGrid x:Name="Grid" Height="240"
                  AutoGenerateColumns="True" IsReadOnly="True"
                  SelectionChanged="Grid_SelectionChanged"/>
    </StackPanel>
</Window>
