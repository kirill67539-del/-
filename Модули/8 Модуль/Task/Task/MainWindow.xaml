<Window x:Class="InteractiveMap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Интерактивная карта"
        Height="760" Width="1200"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="82"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0"
                Background="#172554"
                Padding="24,8">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ИНТЕРАКТИВНАЯ КАРТА"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,2"/>

                    <TextBlock Text="Управление местами и объектами"
                               FontSize="12"
                               Foreground="#B9C7DC"
                               Margin="0,3,0,2"
                               Padding="0,2,0,3"
                               LineStackingStrategy="BlockLineHeight"
                               LineHeight="18"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#263B65"
                        CornerRadius="8"
                        Padding="14,8"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8"
                                 Fill="#4ADE80"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="Режим редактирования"
                                   Foreground="White"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Основная область -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,12,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Места и объекты"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#172554"
                               Margin="0,0,0,14"/>

                    <TextBox x:Name="SearchBox"
                             Grid.Row="1"
                             Height="34"
                             Padding="8,5"
                             FontSize="13"
                             VerticalContentAlignment="Center"
                             ToolTip="Поиск по названию"
                             TextChanged="SearchBox_TextChanged"
                             Margin="0,0,0,10"/>

                    <ComboBox x:Name="CategoryFilter"
                              Grid.Row="2"
                              Height="34"
                              Padding="6,4"
                              FontSize="13"
                              SelectedIndex="0"
                              SelectionChanged="CategoryFilter_SelectionChanged"
                              Margin="0,0,0,12">
                        <ComboBoxItem Content="Все категории"/>
                        <ComboBoxItem Content="Достопримечательность"/>
                        <ComboBoxItem Content="Магазин"/>
                        <ComboBoxItem Content="Кафе"/>
                        <ComboBoxItem Content="Парк"/>
                        <ComboBoxItem Content="Другое"/>
                    </ComboBox>

                    <ListBox x:Name="LocationsList"
                             Grid.Row="3"
                             BorderThickness="0"
                             Background="Transparent"
                             SelectionChanged="LocationsList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8FAFC"
                                        CornerRadius="8"
                                        Padding="9"
                                        Margin="0,0,0,7">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="#1E293B"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding CategoryName}"
                                                   FontSize="11"
                                                   Foreground="#64748B"
                                                   Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding CoordinatesText}"
                                                   FontSize="11"
                                                   Foreground="#64748B"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="LocationsCountText"
                               Grid.Row="4"
                               Text="Объектов: 0"
                               FontSize="12"
                               Foreground="#64748B"
                               Margin="0,12,0,0"/>
                </Grid>
            </Border>

            <!-- Центральная карта -->
            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="12"
                    Padding="10"
                    Margin="0,0,12,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="4,2,4,10">
                        <TextBlock Text="Карта"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#172554"
                                   VerticalAlignment="Center"
                                   DockPanel.Dock="Left"/>

                        <TextBlock Text="Нажмите на карту, чтобы добавить место"
                                   FontSize="11"
                                   Foreground="#64748B"
                                   VerticalAlignment="Center"
                                   TextAlignment="Right"
                                   TextWrapping="Wrap"
                                   DockPanel.Dock="Right"/>
                    </DockPanel>

                    <Border Grid.Row="1"
                            Background="#EAF1F8"
                            CornerRadius="8"
                            ClipToBounds="True">

                        <Canvas x:Name="MapCanvas"
                                Background="#EAF1F8"
                                MouseLeftButtonDown="MapCanvas_MouseLeftButtonDown"
                                SizeChanged="MapCanvas_SizeChanged"/>
                    </Border>

                    <TextBlock Grid.Row="2"
                               Text="Условная карта. Нажмите на свободное место, чтобы добавить объект."
                               FontSize="11"
                               Foreground="#64748B"
                               TextWrapping="Wrap"
                               Margin="4,9,4,2"/>
                </Grid>
            </Border>

            <!-- Правая панель -->
            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="12"
                    Padding="16">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel>
                        <TextBlock Text="Карточка объекта"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#172554"
                                   Margin="0,0,0,5"/>

                        <TextBlock Text="Добавление и редактирование информации"
                                   FontSize="11"
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,18"/>

                        <TextBlock Text="Название"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"
                                   Margin="0,0,0,6"/>

                        <TextBox x:Name="NameBox"
                                 Height="36"
                                 Padding="9,6"
                                 FontSize="13"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,0,14"/>

                        <TextBlock Text="Категория"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"
                                   Margin="0,0,0,6"/>

                        <ComboBox x:Name="CategoryBox"
                                  Height="36"
                                  Padding="7,5"
                                  FontSize="13"
                                  SelectedIndex="0"
                                  Margin="0,0,0,14">
                            <ComboBoxItem Content="Достопримечательность"/>
                            <ComboBoxItem Content="Магазин"/>
                            <ComboBoxItem Content="Кафе"/>
                            <ComboBoxItem Content="Парк"/>
                            <ComboBoxItem Content="Другое"/>
                        </ComboBox>

                        <TextBlock Text="Описание"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"
                                   Margin="0,0,0,6"/>

                        <TextBox x:Name="DescriptionBox"
                                 Height="100"
                                 Padding="9"
                                 FontSize="13"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 Margin="0,0,0,14"/>

                        <TextBlock Text="Координаты на карте"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"
                                   Margin="0,0,0,6"/>

                        <Border Background="#F1F5F9"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,0,0,16">
                            <TextBlock x:Name="CoordinatesLabel"
                                       Text="Не выбрано"
                                       FontSize="12"
                                       Foreground="#475569"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <Button x:Name="AddButton"
                                Content="Добавить объект"
                                Height="38"
                                Background="#2563EB"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="AddButton_Click"
                                Margin="0,0,0,8"/>

                        <Button x:Name="UpdateButton"
                                Content="Сохранить изменения"
                                Height="38"
                                Background="#0F766E"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="UpdateButton_Click"
                                Margin="0,0,0,8"/>

                        <Button x:Name="DeleteButton"
                                Content="Удалить объект"
                                Height="38"
                                Background="#DC2626"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="DeleteButton_Click"
                                Margin="0,0,0,8"/>

                        <Button x:Name="ClearButton"
                                Content="Очистить поля"
                                Height="36"
                                Background="#E2E8F0"
                                Foreground="#334155"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="ClearButton_Click"
                                Margin="0,0,0,18"/>

                        <Separator Margin="0,0,0,14"/>

                        <TextBlock Text="Работа с данными"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#172554"
                                   Margin="0,0,0,10"/>

                        <Button x:Name="SaveButton"
                                Content="Сохранить карту в JSON"
                                Height="36"
                                Background="#334155"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="SaveButton_Click"
                                Margin="0,0,0,8"/>

                        <Button x:Name="LoadButton"
                                Content="Загрузить карту из JSON"
                                Height="36"
                                Background="#475569"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="LoadButton_Click"
                                Margin="0,0,0,18"/>

                        <Separator Margin="0,0,0,14"/>

                        <TextBlock Text="Категории объектов"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#172554"
                                   Margin="0,0,0,10"/>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                <Ellipse Width="10" Height="10" Fill="#2563EB"
                                         Margin="0,0,9,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Достопримечательность" FontSize="11"
                                           Foreground="#475569" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                <Ellipse Width="10" Height="10" Fill="#16A34A"
                                         Margin="0,0,9,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Магазин" FontSize="11"
                                           Foreground="#475569" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                <Ellipse Width="10" Height="10" Fill="#EA580C"
                                         Margin="0,0,9,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Кафе" FontSize="11"
                                           Foreground="#475569" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                <Ellipse Width="10" Height="10" Fill="#9333EA"
                                         Margin="0,0,9,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Парк" FontSize="11"
                                           Foreground="#475569" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="#64748B"
                                         Margin="0,0,9,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Другое" FontSize="11"
                                           Foreground="#475569" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>